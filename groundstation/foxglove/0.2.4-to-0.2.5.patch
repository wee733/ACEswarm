+def finite_fields(data: Any, fields: tuple[str, ...]) -> tuple[float, ...] | None:
+    if not isinstance(data, dict):
+        return None
+    values = tuple(data.get(key) for key in fields)
+    if any(type(v) not in (float, int) or not math.isfinite(v) for v in values):
+        return None
+    return values
+
