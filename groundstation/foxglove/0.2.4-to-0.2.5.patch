+def current_quaternion(value: Any) -> Quaternion | None:
+    q = finite_fields(value, ("x", "y", "z", "w"))
+    if q is None:
+        return None
+    norm = math.hypot(*q)
+    if not math.isfinite(norm) or norm < 1e-8:
+        return None
+    return Quaternion(x=q[0]/norm, y=q[1]/norm, z=q[2]/norm, w=q[3]/norm)
 
 
